# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Telegram (api_id/api_hash from my.telegram.org)
TG_API_ID=123456
TG_API_HASH=your_api_hash
TG_SESSION_NAME=editor_session

# Channel username or id:
# @public_channel OR https://t.me/public_channel OR -1001234567890
TG_CHANNEL=@your_channel

# News provider: cryptonews (recommended) | freecrypto
NEWS_PROVIDER=crypto_news_site

# CryptoNews API key (for NEWS_PROVIDER=cryptonews)
CRYPTONEWS_API_KEY=
CRYPTONEWS_MAX_PAGES_PER_RANGE=40
CRYPTODOTNEWS_MAX_PAGES=120

# FreeCryptoAPI key (for NEWS_PROVIDER=freecrypto)
FREECRYPTO_API_KEY=

# Pexels API key (https://www.pexels.com/api/)
PEXELS_API_KEY=
PREFER_PEXELS_CONTEXT_IMAGE=true

# Optional safety
DRY_RUN=false
LIMIT_PER_RUN=10
MAX_EDITS_PER_HOUR=2

# Hard limit for final edited post text length
MAX_POST_CHARS=800
REQUIRE_NEWS_CONTEXT=true
NEWS_DATE_TOLERANCE_DAYS=1
ADD_NEWS_LINK=false

# Local state file to track already used image URLs + edited message ids
IMAGE_STATE_FILE=image_state.json

# Dynamic context image search URL (must contain {query})
IMAGE_SEARCH_TEMPLATE=https://source.unsplash.com/1600x900/?{query}

# Comma-separated fallback images (used when no image could be resolved)
FALLBACK_CRYPTO_IMAGES=https://images.unsplash.com/photo-1621761191319-c6fb62004040,https://images.unsplash.com/photo-1640826844123-4a0b0cbf4fb8,https://images.unsplash.com/photo-1518544866330-4e38f5c9d3f7

# Context image map (topic:url, comma separated)
CONTEXT_IMAGE_MAP=bitcoin:https://images.unsplash.com/photo-1518546305927-5a555bb7020d,ethereum:https://images.unsplash.com/photo-1622630998477-20aa696ecb05,solana:https://images.unsplash.com/photo-1642104704074-907c0698cbd9,xrp:https://images.unsplash.com/photo-1639762681485-074b7f938ba0,etf:https://images.unsplash.com/photo-1642790551116-18e150f248e5,sec:https://images.unsplash.com/photo-1450101499163-c8848c66ca85,hack:https://images.unsplash.com/photo-1550751827-4bd374c3f58b,mining:https://images.unsplash.com/photo-1518770660439-4636190af475,defi:https://images.unsplash.com/photo-1621504450181-5d356f61d307,nft:https://images.unsplash.com/photo-1634973357973-f2ed2657db3c,stablecoin:https://images.unsplash.com/photo-1520607162513-77705c0f0d4a,market:https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3,crypto:https://images.unsplash.com/photo-1621761191319-c6fb62004040

# Style rotation for contextual image search (comma-separated)
IMAGE_STYLE_ROTATION=macro product photo,dramatic studio lighting,cinematic close-up,high-detail 3d render,editorial photo style,moody low-key lighting,metallic texture focus,minimalist composition
